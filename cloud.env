# ===========================================================================
#  No 5-Hour Limit - CLOUD configuration
#
#  This file drives the GitHub Actions workflow. Unlike config.env it IS
#  committed, so you can edit it from github.com on your phone and the change
#  takes effect on the next run - no computer needed.
#
#  It contains no secrets. Credentials live in repository secrets:
#    CLAUDE_CODE_OAUTH_TOKEN  - from `claude setup-token`
#    CODEX_AUTH_JSON          - contents of ~/.codex/auth.json
# ===========================================================================

# Minutes that must pass since the last successful ping before the next one.
# 301 = 5 hours + 1 minute.
INTERVAL_MINUTES=301

# --- Claude (Anthropic) ----------------------------------------------------
CLAUDE_ENABLED=true
CLAUDE_MODEL=haiku
CLAUDE_PROMPT=ok

# --- Codex (ChatGPT / OpenAI) ---------------------------------------------
# Set to true only after you have added the CODEX_AUTH_JSON secret.
CODEX_ENABLED=false
CODEX_MODEL=
CODEX_PROMPT=ok
CODEX_REASONING_EFFORT=minimal

# --- Housekeeping ----------------------------------------------------------
# The runner is thrown away after every run, so log retention is irrelevant
# here. Quiet hours are evaluated in UTC on the runner, not your local time.
LOG_RETENTION_DAYS=0
QUIET_HOURS=
