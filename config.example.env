# ===========================================================================
#  Limitless 5-Hour - configuration
#  Copy this file to "config.env" and edit it. config.env is git-ignored.
# ===========================================================================

# How many minutes must pass since the last successful ping before the next
# one fires. 301 = 5 hours + 1 minute, so a fresh usage window opens right
# after the previous one closes.
INTERVAL_MINUTES=301

# --- Claude (Anthropic) ----------------------------------------------------
CLAUDE_ENABLED=true
# Cheapest capable model. Use an alias (haiku / sonnet / opus) or a full id.
CLAUDE_MODEL=haiku
# The ping prompt. Keep it as short as possible.
CLAUDE_PROMPT=ok

# --- Codex (ChatGPT / OpenAI) ---------------------------------------------
# Codex has its own 5-hour window. Set to true to keep that one warm too.
CODEX_ENABLED=false
# Leave empty to use whatever model your Codex config defaults to.
CODEX_MODEL=
CODEX_PROMPT=ok
# Reasoning effort for the ping: minimal / low / medium / high
CODEX_REASONING_EFFORT=minimal

# --- Housekeeping ----------------------------------------------------------
# Delete log files older than this many days. 0 = never delete.
LOG_RETENTION_DAYS=30

# Optional quiet hours - skip pings during this local-time range.
# Leave empty for true 24/7 operation. Example: QUIET_HOURS=02:00-08:00
QUIET_HOURS=
